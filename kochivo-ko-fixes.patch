+  expect(rpc.mock.calls.filter(([name]) => name === 'ko_usage_refund')).toHaveLength(1);
+});
diff --git a/src/features/ko-account/secret-check.test.ts b/src/features/ko-account/secret-check.test.ts
new file mode 100644
index 00000000..a6a84438
--- /dev/null
+++ b/src/features/ko-account/secret-check.test.ts
@@ -0,0 +1,96 @@
+import { createHmac } from 'node:crypto';
+import { afterEach, expect, it, vi } from 'vitest';
+import type { KoActor } from './data/account';
+import { verifyKoSecrets } from './data/secret-check';
+
+vi.mock('server-only', () => ({}));
+
+const challenge = 'ko-secret-check';
+const approval = (n: string) => 'a'.repeat(31) + n;
+const meal = (n: string) => 'm'.repeat(31) + n;
+
+afterEach(() => { vi.restoreAllMocks(); vi.unstubAllEnvs(); });
+
+// The mocked RPC answers the way the real ko_secret_check does: true only
+// when the MAC matches the database-side secret for the requested kind.
+function setup(dbSecrets: { approval: string; meal: string }, fail?: 'error' | 'throws') {
+  const rpc = vi.fn(async (name: string, args: { p_kind: string; p_challenge: string; p_mac: string }) => {
+    if (fail === 'throws') throw new Error('Connection failed');
+    if (fail === 'error') return { data: null, error: { message: 'boom' } };
+    const expected = createHmac('sha256', args.p_kind === 'approval' ? dbSecrets.approval : dbSecrets.meal)
+      .update(args.p_challenge).digest('hex');
+    return { data: args.p_mac === expected, error: null };
+  });
+  const actor = { id: 'pilot', role: 'player', db: { rpc } } as unknown as KoActor;
+  return { actor, rpc };
+}
+
+function expectMac(rpc: ReturnType<typeof vi.fn>, kind: 'approval' | 'meal_receipt', secret: string) {
+  const call = rpc.mock.calls.find(([, args]) => (args as { p_kind: string }).p_kind === kind);
+  expect(call?.[0]).toBe('ko_secret_check');
+  expect(call?.[1]).toEqual({
+    p_kind: kind, p_challenge: challenge,
+    p_mac: createHmac('sha256', secret).update(challenge).digest('hex'),
+  });
+}
+
+it('returns [] when both secrets match the database', async () => {
+  vi.stubEnv('KO_MEAL_RECEIPT_SECRET', meal('1'));
+  const { actor, rpc } = setup({ approval: approval('1'), meal: meal('1') });
+  expect(await verifyKoSecrets(actor, { secret: approval('1') })).toEqual([]);
+  expect(rpc).toHaveBeenCalledTimes(2);
+  expectMac(rpc, 'approval', approval('1'));
+  expectMac(rpc, 'meal_receipt', meal('1'));
+});
+
+it('returns the mismatching name when only the approval secret disagrees', async () => {
+  vi.stubEnv('KO_MEAL_RECEIPT_SECRET', meal('2'));
+  const warn = vi.spyOn(console, 'warn').mockImplementation(() => {});
+  const { actor } = setup({ approval: approval('9'), meal: meal('2') });
+  expect(await verifyKoSecrets(actor, { secret: approval('2') })).toEqual(['KO_APPROVAL_SECRET']);
+  expect(warn).toHaveBeenCalledWith('KO secrets do not match the database:', 'KO_APPROVAL_SECRET');
+});
+
+it('returns both names when both secrets disagree', async () => {
+  vi.stubEnv('KO_MEAL_RECEIPT_SECRET', meal('3'));
+  const warn = vi.spyOn(console, 'warn').mockImplementation(() => {});
+  const { actor } = setup({ approval: approval('9'), meal: meal('9') });
+  expect(await verifyKoSecrets(actor, { secret: approval('3') }))
+    .toEqual(['KO_APPROVAL_SECRET', 'KO_MEAL_RECEIPT_SECRET']);
+  expect(warn).toHaveBeenCalledWith(
+    'KO secrets do not match the database:', 'KO_APPROVAL_SECRET, KO_MEAL_RECEIPT_SECRET');
+});
+
+it('treats a missing meal secret as a mismatch without calling the RPC for it', async () => {
+  vi.stubEnv('KO_MEAL_RECEIPT_SECRET', '');
+  const warn = vi.spyOn(console, 'warn').mockImplementation(() => {});
+  const { actor, rpc } = setup({ approval: approval('4'), meal: meal('4') });
+  expect(await verifyKoSecrets(actor, { secret: approval('4') })).toEqual(['KO_MEAL_RECEIPT_SECRET']);
+  expect(rpc).toHaveBeenCalledTimes(1);
+  expect(warn).toHaveBeenCalledWith('KO secrets do not match the database:', 'KO_MEAL_RECEIPT_SECRET');
+});
+
+it('checks once per process per secret value and re-checks when a secret changes', async () => {
+  vi.stubEnv('KO_MEAL_RECEIPT_SECRET', meal('5'));
+  const dbSecrets = { approval: approval('5'), meal: meal('5') };
+  const { actor, rpc } = setup(dbSecrets);
+  expect(await verifyKoSecrets(actor, { secret: approval('5') })).toEqual([]);
+  expect(await verifyKoSecrets(actor, { secret: approval('5') })).toEqual([]);
+  expect(rpc).toHaveBeenCalledTimes(2);
+  // The secret rotated on both sides: the new value is checked once, then cached again.
+  vi.stubEnv('KO_MEAL_RECEIPT_SECRET', meal('6'));
+  dbSecrets.meal = meal('6');
+  expect(await verifyKoSecrets(actor, { secret: approval('5') })).toEqual([]);
+  expect(await verifyKoSecrets(actor, { secret: approval('5') })).toEqual([]);
+  expect(rpc).toHaveBeenCalledTimes(4);
+});
+
+it.each(['error', 'throws'] as const)('swallows RPC %s as a mismatch instead of throwing', async fail => {
+  vi.stubEnv('KO_MEAL_RECEIPT_SECRET', fail === 'error' ? meal('7') : meal('8'));
+  const warn = vi.spyOn(console, 'warn').mockImplementation(() => {});
+  const secret = fail === 'error' ? approval('7') : approval('8');
+  const { actor } = setup({ approval: secret, meal: meal('7') }, fail);
+  expect(await verifyKoSecrets(actor, { secret })).toEqual(['KO_APPROVAL_SECRET', 'KO_MEAL_RECEIPT_SECRET']);
+  expect(warn).toHaveBeenCalledWith(
+    'KO secrets do not match the database:', 'KO_APPROVAL_SECRET, KO_MEAL_RECEIPT_SECRET');
+});
diff --git a/supabase/migrations/0165_ko_usage_refund.sql b/supabase/migrations/0165_ko_usage_refund.sql
new file mode 100644
index 00000000..ce8932a0
--- /dev/null
+++ b/supabase/migrations/0165_ko_usage_refund.sql
@@ -0,0 +1,75 @@
+create table security_private.ko_usage_refunds (
+  key uuid not null primary key,
+  user_id uuid not null,
+  day date not null,
+  kind text not null check (kind in ('message', 'photo')),
+  created_at timestamptz not null default now()
+);
+alter table security_private.ko_usage_refunds enable row level security;
+revoke all on security_private.ko_usage_refunds from public, anon, authenticated;
+
+-- Refund one taken KO message/photo. The key is the idempotency key: a second
+-- call with the same key is a no-op. The key is recorded even when no counter
+-- moves, so an unknown-key refund still applies exactly once (and the floor of
+-- 0 keeps the counters from going negative); the route only refunds after
+-- ko_usage_take returned 'ok', so in practice every refund balances a take.
+create function public.ko_usage_refund(p_day date, p_kind text, p_key uuid) returns boolean
+language plpgsql security definer set search_path = '' as $$
+declare
+  owner_id uuid := security_private.ko_usage_owner(false);
+  month_start date := date_trunc('month', now() at time zone 'Africa/Cairo')::date;
+begin
+  if p_key is null or p_kind is null or p_kind not in ('message', 'photo')
+    or p_day is null or p_day not between (now() at time zone 'UTC')::date - 1 and (now() at time zone 'UTC')::date + 1 then
+    raise exception 'invalid usage refund parameters' using errcode = '22023';
+  end if;
+  insert into security_private.ko_usage_refunds(key, user_id, day, kind)
+    values (p_key, auth.uid(), p_day, p_kind) on conflict do nothing;
+  if not found then return false; end if;
+  if p_kind = 'message' then
+    update security_private.ko_usage_daily set messages = greatest(messages - 1, 0)
+      where user_id = auth.uid() and day = p_day;
+  else
+    update security_private.ko_usage_daily set photos = greatest(photos - 1, 0)
+      where user_id = auth.uid() and day = p_day;
+  end if;
+  update security_private.ko_usage_monthly set calls = greatest(calls - 1, 0)
+    where captain_id = owner_id and month = month_start;
+  return true;
+end;
+$$;
+
+-- Refund one taken big-action credit. Only when the action did not apply: a
+-- receipt in ko_action_receipts means it did. A failed ko_apply_action rolls
+-- its whole call back, receipt included, so an error such as 40001 (the
+-- prescription changed before anything was written) leaves no receipt and
+-- the credit is refunded; a replayed confirmation leaves the receipt behind
+-- and is never refunded. Deleting the approval row makes the refund itself
+-- idempotent and lets a later retry of the same token take a fresh credit.
+create function public.ko_credit_refund(p_month date, p_token text) returns boolean
+language plpgsql security definer set search_path = '' as $$
+declare
+  owner_id uuid := security_private.ko_usage_owner(true);
+  approved jsonb := ko_private.verified_approval(p_token);
+  approval_id uuid := (approved ->> 'id')::uuid;
+begin
+  if p_month is distinct from date_trunc('month', now() at time zone 'Africa/Cairo')::date then
+    raise exception 'invalid credit refund parameters' using errcode = '22023';
+  end if;
+  if exists (select 1 from ko_private.ko_action_receipts
+    where captain_id = owner_id and action_id = approval_id) then
+    return false;
+  end if;
+  delete from security_private.ko_credit_approvals
+    where captain_id = owner_id and action_id = approval_id;
+  if not found then return false; end if;
+  update security_private.ko_usage_monthly set credits = greatest(credits - 1, 0)
+    where captain_id = owner_id and month = p_month;
+  return true;
+end;
+$$;
+
+revoke all on function public.ko_usage_refund(date, text, uuid),
+  public.ko_credit_refund(date, text) from public, anon, authenticated;
+grant execute on function public.ko_usage_refund(date, text, uuid),
+  public.ko_credit_refund(date, text) to authenticated;
diff --git a/supabase/migrations/0166_ko_memory_scope.sql b/supabase/migrations/0166_ko_memory_scope.sql
new file mode 100644
index 00000000..5aed74c8
--- /dev/null
+++ b/supabase/migrations/0166_ko_memory_scope.sql
@@ -0,0 +1,20 @@
+-- T-423: scope KO memory uniqueness per (user, player).
+--
+-- The old index on (user_id, lower(text)) treated a note saved for one player
+-- as a collision for every other player, and let two general (NULL-player)
+-- notes with the same text both insert, because Postgres treats NULLs as
+-- distinct in a unique index. NULLS NOT DISTINCT makes NULL player_id a
+-- value, so the same text exists at most once per (user, player) — including
+-- once for general notes. It needs Postgres 15+; Supabase runs Postgres 15
+-- or 17 and the PGlite test database is 18, so no coalesce fallback is used.
+--
+-- Backfill is a no-op by construction: every existing row already carries the
+-- player_id it was saved with (a resolved roster player, or NULL for a
+-- general note). Creating the new index cannot fail on existing data either:
+-- the old index already forbade two rows with the same user and text, so no
+-- (user, player, text) collision can exist. The 30-row trim trigger stays
+-- per-user and is unchanged.
+begin;
+drop index if exists public.ko_memories_text_idx;
+create unique index ko_memories_text_idx on public.ko_memories (user_id, player_id, lower(text)) nulls not distinct;
+commit;
diff --git a/supabase/migrations/0167_ko_secret_check.sql b/supabase/migrations/0167_ko_secret_check.sql
new file mode 100644
index 00000000..521c5ce6
--- /dev/null
+++ b/supabase/migrations/0167_ko_secret_check.sql
@@ -0,0 +1,39 @@
+-- T-426: one enforced source of truth for KO secrets.
+--
+-- The app signs approval tokens with env KO_APPROVAL_SECRET while the DB
+-- verifies them against security_private.ko_approval_config.signing_key,
+-- and signs meal receipts with env KO_MEAL_RECEIPT_SECRET while the DB
+-- verifies against security_private.app_secrets ('meal_receipt'). Nothing
+-- seeded either side or checked they match, so a disagreement silently
+-- broke every KO confirmation and skipped meal points. This function
+-- proves agreement without ever revealing a secret value: the app HMACs
+-- a fixed challenge with its env secret and the DB compares it with an
+-- HMAC from its stored key, returning only a boolean. It lives in public
+-- like the other ko RPCs: PostgREST only serves exposed schemas and
+-- ko_private is deliberately not exposed (T-116), so a ko_private function
+-- would be unreachable from the app and KO would fail closed everywhere.
+-- Kind 'approval'
+-- also covers the usage-warning proof, which is signed with the same
+-- approval key (ko_usage_claim_warning).
+begin;
+create function public.ko_secret_check(p_kind text, p_challenge text, p_mac text) returns boolean
+language plpgsql security definer set search_path = '' as $$
+declare
+  v_secret text;
+begin
+  if p_kind = 'approval' then
+    select signing_key into v_secret from security_private.ko_approval_config where singleton;
+  elsif p_kind = 'meal_receipt' then
+    select value into v_secret from security_private.app_secrets where name = 'meal_receipt';
+  else
+    return false;
+  end if;
+  if v_secret is null or p_challenge is null or p_mac is null then
+    return false;
+  end if;
+  return p_mac = encode(extensions.hmac(convert_to(p_challenge, 'UTF8'), convert_to(v_secret, 'UTF8'), 'sha256'), 'hex');
+end;
+$$;
+revoke all on function public.ko_secret_check(text, text, text) from public, anon, authenticated;
+grant execute on function public.ko_secret_check(text, text, text) to authenticated;
+commit;
diff --git a/supabase/tests/ko-secret-check.test.ts b/supabase/tests/ko-secret-check.test.ts
new file mode 100644
index 00000000..4a17f1be
--- /dev/null
+++ b/supabase/tests/ko-secret-check.test.ts
@@ -0,0 +1,55 @@
+import { createHmac } from 'node:crypto';
+import type { PGlite } from '@electric-sql/pglite';
+import { afterAll, beforeAll, beforeEach, expect, it } from 'vitest';
+import { asUser, createTestDb, createUser } from './harness';
+
+const challenge = 'ko-secret-check';
+const approvalSecret = 'approval-test-secret-0123456789ab';
+const mealSecret = 'meal-receipt-test-secret-01234567';
+let db: PGlite;
+let player: string;
+beforeAll(async () => { db = await createTestDb(); });
+afterAll(async () => { await db.close(); });
+beforeEach(async () => {
+  player = await createUser(db, 'player');
+  await db.query(`insert into security_private.ko_approval_config(signing_key) values ($1)
+    on conflict (singleton) do update set signing_key = excluded.signing_key`, [approvalSecret]);
+  await db.query(`insert into security_private.app_secrets(name, value) values ('meal_receipt', $1)
+    on conflict (name) do update set value = excluded.value`, [mealSecret]);
+});
+
+const mac = (secret: string) => createHmac('sha256', secret).update(challenge).digest('hex');
+async function check(kind: string, secret: string, who = player) {
+  const result = await asUser(db, who, tx => tx.query<{ ko_secret_check: boolean }>(
+    'select public.ko_secret_check($1, $2, $3) as ko_secret_check', [kind, challenge, mac(secret)]));
+  return result.rows[0]?.ko_secret_check;
+}
+
+it('returns true for the stored approval and meal-receipt keys', async () => {
+  expect(await check('approval', approvalSecret)).toBe(true);
+  expect(await check('meal_receipt', mealSecret)).toBe(true);
+});
+
+it('returns false for a wrong key', async () => {
+  expect(await check('approval', 'wrong-approval-secret-012345678')).toBe(false);
+  expect(await check('meal_receipt', 'wrong-meal-secret-012345678901')).toBe(false);
+});
+
+it('returns false for an unknown kind', async () => {
+  expect(await check('usage_warning', approvalSecret)).toBe(false);
+});
+
+it('returns false when the database key is missing', async () => {
+  await db.query('delete from security_private.ko_approval_config');
+  expect(await check('approval', approvalSecret)).toBe(false);
+  await db.query("delete from security_private.app_secrets where name = 'meal_receipt'");
+  expect(await check('meal_receipt', mealSecret)).toBe(false);
+});
+
+it('denies anon execution', async () => {
+  await expect(db.transaction(async tx => {
+    await tx.exec('set local role anon');
+    await tx.query('select public.ko_secret_check($1, $2, $3)',
+      ['approval', challenge, mac(approvalSecret)]);
+  })).rejects.toMatchObject({ code: '42501' });
+});
diff --git a/supabase/tests/ko-usage-refund.test.ts b/supabase/tests/ko-usage-refund.test.ts
new file mode 100644
index 00000000..e9cdfb0f
--- /dev/null
+++ b/supabase/tests/ko-usage-refund.test.ts
@@ -0,0 +1,116 @@
+import type { PGlite } from '@electric-sql/pglite';
+import { createHmac } from 'node:crypto';
+import { afterAll, beforeAll, expect, it } from 'vitest';
+import { asUser, createCaptainWithPlayer, createTestDb, createUser, dayOffset, TEST_NOW } from './harness';
+
+let db: PGlite;
+let first: Awaited<ReturnType<typeof createCaptainWithPlayer>>;
+const month = '2026-11-01';
+const secret = 'ko-test-signing-key-123456789012345';
+
+beforeAll(async () => {
+  db = await createTestDb(async (file, instance) => {
+    if (file !== '0158_ko_usage.sql') return;
+    await instance.exec(`
+      create or replace function pg_catalog.now() returns timestamptz language sql stable as $$
+        select coalesce(nullif(current_setting('test.usage_now', true), '')::timestamptz, timestamptz '${TEST_NOW}')
+      $$;
+    `);
+  });
+  first = await createCaptainWithPlayer(db);
+  await db.query('insert into security_private.ko_approval_config(signing_key) values ($1)', [secret]);
+});
+afterAll(async () => db?.close());
+
+async function usage(id: string, day: string, kind = 'message', caps = [2, 1, 5]) {
+  const { rows } = await asUser(db, id, tx => tx.query<{ result: string }>(
+    'select public.ko_usage_take($1,$2,$3,$4,$5) as result', [day, kind, ...caps]));
+  return rows[0]?.result;
+}
+
+async function refundUsage(id: string, day: string, kind: string, key: string, anonymous = false) {
+  const { rows } = await asUser(db, id, tx => tx.query<{ result: boolean }>(
+    'select public.ko_usage_refund($1,$2,$3) as result', [day, kind, key]), anonymous);
+  return rows[0]?.result;
+}
+
+async function counters(captain: string, user: string, day: string) {
+  const { rows } = await db.query(
+    `select (select messages from security_private.ko_usage_daily where user_id=$2 and day=$3) as messages,
+      (select photos from security_private.ko_usage_daily where user_id=$2 and day=$3) as photos,
+      (select calls from security_private.ko_usage_monthly where captain_id=$1 and month=$4) as calls,
+      (select credits from security_private.ko_usage_monthly where captain_id=$1 and month=$4) as credits`,
+    [captain, user, day, month]);
+  return rows[0] as { messages: number | null; photos: number | null; calls: number | null; credits: number | null };
+}
+
+const tokenFor = (captain: string, index: number) => {
+  const body = Buffer.from(JSON.stringify({
+    id: `00000000-0000-7000-8000-00000000000${index}`, actor: captain,
+    kind: 'training', expires: Date.parse(TEST_NOW) + 60_000,
+  })).toString('base64url');
+  return body + '.' + createHmac('sha256', secret).update(body).digest('hex');
+};
+
+async function takeCredit(captain: string, signed: string, cap = 2) {
+  const { rows } = await asUser(db, captain, tx => tx.query<{ result: boolean }>(
+    'select public.ko_credit_take($1,$2,$3) as result', [month, cap, signed]));
+  return rows[0]?.result;
+}
+
+async function refundCredit(captain: string, signed: string, anonymous = false) {
+  const { rows } = await asUser(db, captain, tx => tx.query<{ result: boolean }>(
+    'select public.ko_credit_refund($1,$2) as result', [month, signed]), anonymous);
+  return rows[0]?.result;
+}
+
+const key = (index: number) => `00000000-0000-7000-8000-0000000000${index}0`;
+
+it('returns message and photo counters to their prior values and refunds each key once', async () => {
+  const today = await dayOffset(db, 0);
+  expect(await usage(first.player, today)).toBe('ok');
+  expect(await usage(first.player, today, 'photo')).toBe('ok');
+  expect(await counters(first.captain, first.player, today)).toEqual({ messages: 1, photos: 1, calls: 2, credits: 0 });
+  expect(await refundUsage(first.player, today, 'message', key(1))).toBe(true);
+  expect(await refundUsage(first.player, today, 'message', key(1))).toBe(false);
+  expect(await counters(first.captain, first.player, today)).toEqual({ messages: 0, photos: 1, calls: 1, credits: 0 });
+  expect(await refundUsage(first.player, today, 'photo', key(2))).toBe(true);
+  expect(await counters(first.captain, first.player, today)).toEqual({ messages: 0, photos: 0, calls: 0, credits: 0 });
+});
+
+it('refunds a second take with a different key but never drives a counter below 0', async () => {
+  const today = await dayOffset(db, 0);
+  expect(await usage(first.player, today)).toBe('ok');
+  expect(await usage(first.player, today)).toBe('ok');
+  expect(await refundUsage(first.player, today, 'message', key(3))).toBe(true);
+  expect(await refundUsage(first.player, today, 'message', key(4))).toBe(true);
+  expect(await counters(first.captain, first.player, today)).toEqual({ messages: 0, photos: 0, calls: 0, credits: 0 });
+  // Unknown-key refund: no take backs it, so it applies once, records the key,
+  // and the floor of 0 keeps the counters where they were.
+  expect(await refundUsage(first.player, today, 'message', key(5))).toBe(true);
+  expect(await refundUsage(first.player, today, 'message', key(5))).toBe(false);
+  expect(await counters(first.captain, first.player, today)).toEqual({ messages: 0, photos: 0, calls: 0, credits: 0 });
+});
+
+it('restores a taken credit once and is blocked when a receipt exists', async () => {
+  const captain = await createUser(db, 'captain');
+  const signed = tokenFor(captain, 1);
+  expect(await takeCredit(captain, signed)).toBe(true);
+  expect((await counters(captain, captain, await dayOffset(db, 0))).credits).toBe(1);
+  expect(await refundCredit(captain, signed)).toBe(true);
+  expect((await counters(captain, captain, await dayOffset(db, 0))).credits).toBe(0);
+  expect(await refundCredit(captain, signed)).toBe(false);
+  // A fresh take followed by a receipt blocks the refund: the action applied.
+  const applied = tokenFor(captain, 2);
+  expect(await takeCredit(captain, applied)).toBe(true);
+  await db.query('insert into ko_private.ko_action_receipts(captain_id, action_id) values ($1, $2)',
+    [captain, '00000000-0000-7000-8000-000000000002']);
+  expect(await refundCredit(captain, applied)).toBe(false);
+  expect((await counters(captain, captain, await dayOffset(db, 0))).credits).toBe(1);
+});
+
+it('refuses anonymous callers for both refund RPCs', async () => {
+  const today = await dayOffset(db, 0);
+  await expect(refundUsage(first.player, today, 'message', key(6), true)).rejects.toMatchObject({ code: '42501' });
+  await expect(refundCredit(first.captain, tokenFor(first.captain, 3), true)).rejects.toMatchObject({ code: '42501' });
+});
