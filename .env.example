# Copy to .env.local and fill from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public VAPID key for web push; leave empty to hide the setting.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Owner WhatsApp number with country code, for captain plan upgrades.
NEXT_PUBLIC_OWNER_WHATSAPP=

# Optional Sentry DSN; leave empty to disable crash reporting.
NEXT_PUBLIC_SENTRY_DSN=

# Set to 1 to show the KO teaser to signed-in non-pilot accounts.
KO_TEASER_ENABLED=
# Comma-separated user ids that get the real KO, or * for every signed-in account.
# KO also needs KO_ENABLED=1 and KO_GEMINI_PAID=1 (a billed Gemini project).
KO_PILOT_USER_IDS=

# MCP pilot. Uses KO_ORIGIN as its public origin.
# Use * for all eligible users, or a comma-separated list of user IDs.
MCP_ENABLED=
MCP_PILOT_USER_IDS=
# Server secret that signs meal-photo point receipts; must match security_private.app_secrets.meal_receipt.
KO_MEAL_RECEIPT_SECRET=

# Ranks, points and the crown for players and captains. Leave empty to keep them hidden; set to 1 to show.
NEXT_PUBLIC_RANKS_ENABLED=
