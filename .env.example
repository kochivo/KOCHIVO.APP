# Copy to .env.local and fill from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public VAPID key for web push; leave empty to hide the setting.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Owner WhatsApp number with country code, for captain plan upgrades.
NEXT_PUBLIC_OWNER_WHATSAPP=

# Optional Sentry DSN; leave empty to disable crash reporting.
NEXT_PUBLIC_SENTRY_DSN=

# Set to 1 to show the KO teaser to signed-in non-pilot accounts.
KO_TEASER_ENABLED=
# Server secret that signs meal-photo point receipts; must match security_private.app_secrets.meal_receipt.
KO_MEAL_RECEIPT_SECRET=
